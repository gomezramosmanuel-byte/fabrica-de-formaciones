# GEMINI_API_KEY: Required for Gemini AI API calls (Course Draft Generator & Tutor IA).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional - Server-side connection to Supabase PostgreSQL & Storage)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# ADMIN CREDENTIALS (Optional override for default administrator login)
ADMIN_EMAIL="admin@fabricaformacion.co"
ADMIN_PASSWORD_HASH=""
